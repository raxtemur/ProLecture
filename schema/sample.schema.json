{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProLecture sample",
  "type": "object",
  "required": [
    "id",
    "video",
    "question",
    "question_time",
    "act",
    "temporal_rel",
    "reasoning_level",
    "template",
    "triggers",
    "audio_dependency",
    "provenance",
    "validation"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "twin_of": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "video": {
      "type": "object",
      "required": [
        "youtube_id",
        "title",
        "release_date",
        "duration"
      ],
      "additionalProperties": false,
      "properties": {
        "youtube_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "release_date": {
          "type": "string"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_code": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "string",
      "minLength": 20
    },
    "question_time": {
      "type": "number",
      "minimum": 0
    },
    "act": {
      "enum": [
        "alert",
        "monitor",
        "ground",
        "narrate",
        "predict",
        "verify",
        "counterfact"
      ]
    },
    "temporal_rel": {
      "enum": [
        "pre",
        "at",
        "post"
      ]
    },
    "reasoning_level": {
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "template": {
      "type": "string"
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "idx",
          "required",
          "t_start",
          "t_end",
          "t_ideal",
          "response",
          "rubric",
          "trigger_modality",
          "evidence_span"
        ],
        "additionalProperties": false,
        "properties": {
          "idx": {
            "type": "integer",
            "minimum": 0
          },
          "required": {
            "type": "boolean"
          },
          "t_start": {
            "type": "number",
            "minimum": 0
          },
          "t_end": {
            "type": "number",
            "minimum": 0
          },
          "t_ideal": {
            "type": "number",
            "minimum": 0
          },
          "response": {
            "type": "string",
            "minLength": 10
          },
          "rubric": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "trigger_modality": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "visual",
                "speech",
                "sound"
              ]
            },
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          },
          "evidence_span": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "description": "where the latest piece of evidence lies, the one from which the answer follows by t_end; this is the evidence, not the corroboration: what establishes that the reference answer itself is correct lives in provenance.evidence and may lie after the window (predict) or outside the video (counterfact)",
            "items": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "distractor_windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t_start",
          "t_end",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "t_start": {
            "type": "number",
            "minimum": 0
          },
          "t_end": {
            "type": "number",
            "minimum": 0
          },
          "why": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "audio_dependency": {
      "enum": [
        "required",
        "unnecessary",
        null
      ]
    },
    "audio_dependency_claim": {
      "enum": [
        "required",
        "helpful",
        "unnecessary"
      ]
    },
    "followup": {
      "type": "object",
      "required": [
        "question",
        "answer"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "annotator",
        "created",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "annotator": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "description": "where the reference answer came from; structured so that the references can be checked automatically rather than by regular expression. This is where the corroboration lives — what establishes that the reference answer is correct; unlike evidence_span it may lie after the answer window (predict) or outside the video altogether (counterfact, type: other)",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "t",
                  "explanation"
                ],
                "properties": {
                  "type": {
                    "const": "frame"
                  },
                  "t": {
                    "type": "number",
                    "minimum": 0
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 5,
                    "description": "why this reference is here: what exactly can be seen or heard at this point"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "t_start",
                  "t_end",
                  "explanation"
                ],
                "properties": {
                  "type": {
                    "const": "speech"
                  },
                  "t_start": {
                    "type": "number",
                    "minimum": 0
                  },
                  "t_end": {
                    "type": "number",
                    "minimum": 0
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 5,
                    "description": "why this reference is here: what exactly can be seen or heard at this point"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "explanation"
                ],
                "properties": {
                  "type": {
                    "const": "other"
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 5,
                    "description": "why this reference is here: what exactly can be seen or heard at this point"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "description": "Review lifecycle and correctness: validated means complete and correct; rejected means incorrect or deliberately abandoned. Primary benchmark eligibility is determined separately by blind_solved.",
          "enum": [
            "draft",
            "validated",
            "rejected"
          ]
        },
        "solvable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "blind_solved": {
          "description": "Whether the answer was obtained without viewing the video. A true value excludes the sample from the primary benchmark but does not by itself prevent status=validated.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "textonly_solved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "visiononly_solved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "frozenframe_solved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "question_time_note": {
      "type": "string",
      "minLength": 10
    }
  }
}

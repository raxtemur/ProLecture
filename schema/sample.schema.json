{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProLecture sample",
  "type": "object",
  "required": [
    "id",
    "video",
    "question",
    "question_time",
    "act",
    "temporal_rel",
    "reasoning_level",
    "template",
    "triggers",
    "audio_dependency",
    "provenance",
    "validation"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "video": {
      "type": "object",
      "required": [
        "youtube_id",
        "title",
        "release_date",
        "duration"
      ],
      "additionalProperties": false,
      "properties": {
        "youtube_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "release_date": {
          "type": "string"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_code": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "string",
      "minLength": 20
    },
    "question_time": {
      "type": "number",
      "minimum": 0
    },
    "act": {
      "enum": [
        "alert",
        "monitor",
        "ground",
        "narrate",
        "predict",
        "verify",
        "counterfact"
      ]
    },
    "temporal_rel": {
      "enum": [
        "pre",
        "at",
        "post"
      ]
    },
    "reasoning_level": {
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "template": {
      "type": "string"
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "idx",
          "required",
          "t_start",
          "t_end",
          "t_ideal",
          "response",
          "rubric",
          "trigger_modality"
        ],
        "additionalProperties": false,
        "properties": {
          "idx": {
            "type": "integer",
            "minimum": 0
          },
          "required": {
            "type": "boolean"
          },
          "t_start": {
            "type": "number",
            "minimum": 0
          },
          "t_end": {
            "type": "number",
            "minimum": 0
          },
          "t_ideal": {
            "type": "number",
            "minimum": 0
          },
          "response": {
            "type": "string",
            "minLength": 10
          },
          "rubric": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "trigger_modality": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "visual",
                "speech",
                "sound"
              ]
            },
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          },
          "evidence_span": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "distractor_windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t_start",
          "t_end",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "t_start": {
            "type": "number",
            "minimum": 0
          },
          "t_end": {
            "type": "number",
            "minimum": 0
          },
          "why": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "audio_dependency": {
      "enum": [
        "required",
        "helpful",
        "unnecessary",
        null
      ]
    },
    "audio_dependency_claim": {
      "enum": [
        "required",
        "helpful",
        "unnecessary"
      ]
    },
    "followup": {
      "type": "object",
      "required": [
        "question",
        "answer"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "annotator",
        "created",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "annotator": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "chapter": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "draft",
            "validated",
            "rejected"
          ]
        },
        "blind_solved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "textonly_solved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "visiononly_solved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "frozenframe_solved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "question_time_note": {
      "type": "string",
      "minLength": 10
    }
  }
}
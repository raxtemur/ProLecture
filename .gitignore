__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store

# third-party repositories, cloned separately
vendor/

# heavy artifacts — reproduced by the scripts in tools/
data/videos/
data/bundles/*/frames/
data/bundles/*/frames_desc/
data/bundles/*/frames_desc_*/
data/bundles/*/frames_scenes/

# trial description runs: the name is set by --out-prefix and starts with an underscore
data/bundles/*/_*.jsonl
data/bundles/*/_*.md
demo/media/

# paper sources: we keep only the reviews and the figures
articles/*/paper.pdf
articles/*/source/
articles/*/figures/*.pdf

# reviewer workspaces, reproduced by tools/prepare_review_workspace.py
.review_ws/
docs/presentation/*.aux
docs/presentation/*.log
docs/presentation/*.nav
docs/presentation/*.out
docs/presentation/*.snm
docs/presentation/*.toc
docs/presentation/page-*.png

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store

# third-party repositories, cloned separately
vendor/

# per-video data — published as separate artifacts rather than through this repository.
# Whatever is already tracked stays tracked; a new video adds nothing here by itself.
data/videos/
data/bundles/
data/reviews/
data/annotations/
demo/media/

# runs of the models under evaluation: produced by scripts that live outside this repository,
# so committing them would fix numbers nothing here can reproduce
data/outputs/

# paper sources: we keep only the reviews and the figures
articles/*/paper.pdf
articles/*/source/
articles/*/figures/*.pdf

# reviewer workspaces, reproduced by tools/prepare_review_workspace.py
.review_ws/
docs/presentation/*.aux
docs/presentation/*.log
docs/presentation/*.nav
docs/presentation/*.out
docs/presentation/*.snm
docs/presentation/*.toc
docs/presentation/page-*.png

# local state of the CLI tools
.codex/

# working notes: reports are the user's own material, not project documentation
docs/reports/
